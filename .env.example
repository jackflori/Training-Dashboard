# Copy to .env.local and fill in as needed. Everything here is optional for
# local development — with no database and no password set, the app runs off a
# local JSON file and is fully editable.

# ---- Database ----
# When DATABASE_URL is set, persistence uses Postgres via Prisma. When it isn't,
# the app falls back to a JSON file under DATA_DIR. Required in production:
# serverless filesystems are read-only, so the file store cannot work there.
# DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require"
#
# Direct (non-pooled) connection, used only for migrations — they need a real
# session rather than a pooled one. Same string with "-pooler" removed.
# DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/db?sslmode=require"

# Where the file-backed store writes its JSON when no database is configured.
DATA_DIR=./data

# ---- Edit gate ----
# Reads are always public. Writes require signing in with this password.
# Leave unset locally and everything stays editable without signing in.
# In production, leaving it unset makes the app read-only rather than open.
# AUTH_PASSWORD="choose-something-long"
#
# Secret used to sign the session cookie. Defaults to AUTH_PASSWORD if unset;
# set it separately in production so rotating one doesn't force the other.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET="..."

# ---- Season defaults ----
# Seed values only — all three are editable in the UI (Season settings), which
# persists them. These apply on first run before anything is saved.

# ISO date (YYYY-MM-DD) of your goal race. Powers the countdown.
NATIONALS_DATE=2026-11-21
# Last day the sliding calendar should show. Defaults to NATIONALS_DATE if unset.
SEASON_END_DATE=2026-11-23
# First day the season-to-date totals start counting from.
SEASON_START_DATE=2026-09-01
