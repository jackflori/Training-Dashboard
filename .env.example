# All of these are optional — the app runs with the defaults below and every
# value is editable in the UI (Season settings), which persists it to the store.
# This file only seeds the initial values on first run.

# Where the file-backed store writes its JSON. Relative to the project root.
DATA_DIR=./data

# ISO date (YYYY-MM-DD) of your goal race. Powers the countdown.
NATIONALS_DATE=2026-11-21
# Last day the sliding calendar should show. Defaults to NATIONALS_DATE if unset.
SEASON_END_DATE=2026-11-23
# First day the season-to-date totals start counting from.
SEASON_START_DATE=2026-09-01

# ---- Phase 2 (not used yet) ----
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
